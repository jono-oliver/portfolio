---
import SanityImage from "./SanityImage.astro";
import Pills from "./Pills.astro";

const {
  title,
  excerpt,
  tags,
  tagsLabel,
  image,
  backHref,
  backLabel,
  transitionName,
} = Astro.props;
---

<header data-xray="DetailHeader">
  <div class="container pt-10 lg:pt-16">
    <a
      href={backHref}
      class="eyebrow group inline-flex items-center gap-2 transition-colors hover:text-ink"
    >
      <span
        class="inline-block transition-transform duration-500 ease-out-expo group-hover:-translate-x-1.5"
        aria-hidden="true">&larr;</span
      >
      {backLabel}
    </a>

    <h1 class="mt-8 break-words text-display-md font-bold">
      <span data-reveal="mask"><span>{title}</span></span>
    </h1>

    <dl
      class="mt-10 grid gap-6 border-t border-line pt-6 sm:grid-cols-3"
      data-reveal="up"
      style="--reveal-delay: 150ms"
    >
      <div>
        <dt class="eyebrow">{tagsLabel}</dt>
        <dd class="mt-3"><Pills items={tags} /></dd>
      </div>
      <div class="sm:col-span-2">
        <dt class="eyebrow">Overview</dt>
        <dd class="mt-2 max-w-xl text-sm leading-relaxed">{excerpt}</dd>
      </div>
    </dl>
  </div>

  <div class="mt-10 overflow-hidden lg:mt-16" transition:name={transitionName}>
    <SanityImage
      classes="h-[50vh] w-full object-cover object-center lg:h-[75vh]"
      node={image}
      width="2000"
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>
</header>
