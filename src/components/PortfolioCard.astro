---
import SanityImage from "../components/SanityImage.astro";
import Pills from "./Pills.astro";

const { title, imageCard, slug, excerpt, stack, index } = Astro.props;
---

<li
  class="border-b border-line"
  data-reveal="up"
  style={`--reveal-delay: ${Math.min(index, 5) * 80}ms`}
>
  <a
    href={`/portfolio/${slug}`}
    class="group relative block overflow-hidden py-8 focus-visible:outline-offset-0 lg:px-6 lg:py-10"
  >
    <!-- Accent panel that wipes up behind the row on hover (desktop) -->
    <span
      class="absolute inset-0 hidden origin-bottom scale-y-0 bg-accent transition-transform duration-700 ease-out-expo group-hover:scale-y-100 group-focus-visible:scale-y-100 lg:block"
      aria-hidden="true"></span>

    <div class="mb-6 overflow-hidden lg:hidden">
      <SanityImage
        classes="aspect-[4/3] w-full object-cover"
        node={imageCard}
        width="800"
      />
    </div>

    <div
      class="relative grid grid-cols-12 items-center gap-x-4 gap-y-3 transition-colors duration-500 lg:group-hover:text-white lg:group-focus-visible:text-white"
    >
      <div
        class="col-span-2 hidden aspect-[4/3] overflow-hidden lg:block"
        aria-hidden="true"
      >
        <SanityImage
          classes="h-full w-full object-cover transition-transform duration-1000 ease-out-expo group-hover:scale-110 group-focus-visible:scale-110"
          node={imageCard}
          width="400"
        />
      </div>
      <div
        class="col-span-12 transition-transform duration-700 ease-out-expo lg:col-span-9 lg:pl-4 lg:group-hover:translate-x-4 lg:group-focus-visible:translate-x-4"
      >
        <h3
          class="text-2xl font-bold uppercase tracking-tight transition-colors duration-500 sm:text-3xl lg:text-3xl lg:group-hover:text-white lg:group-focus-visible:text-white xl:text-4xl"
        >
          {title}
        </h3>
        <Pills items={stack} inverts class="mt-4" aria-label="Tech stack" />
      </div>
      <span
        class="col-span-1 hidden h-12 w-12 place-items-center justify-self-end rounded-full border border-line transition-colors duration-500 group-hover:border-white/40 group-focus-visible:border-white/40 lg:grid"
        aria-hidden="true"
      >
        <span
          class="inline-block transition-transform duration-700 ease-out-expo group-hover:-rotate-45 group-focus-visible:-rotate-45"
          >&rarr;</span
        >
      </span>
      <p class="col-span-12 text-sm leading-relaxed lg:hidden">
        {excerpt}
      </p>
    </div>
  </a>
</li>
