---
import SanityImage from "./SanityImage.astro";
import Pills from "./Pills.astro";
const {
  title,
  type,
  projectImage,
  slug,
  excerpt,
  stack,
  index = 0,
} = Astro.props;
const flip = index % 2 === 1;
---

<article data-xray="Article" class="border-t border-line py-10 lg:py-16">
  <a
    href={`/${type}/${slug}`}
    class="group grid gap-8 lg:grid-cols-12 lg:items-center lg:gap-12"
  >
    <div
      class:list={["overflow-hidden lg:col-span-7", { "lg:order-2": flip }]}
      transition:name={`${type}-${slug}`}
    >
      <div class="overflow-hidden" data-reveal="image">
        <SanityImage
          classes="aspect-[16/10] w-full object-cover transition-transform duration-1000 ease-out-expo group-hover:scale-105"
          node={projectImage}
          width="1440"
        />
      </div>
    </div>

    <div class="lg:col-span-5" data-reveal="up" style="--reveal-delay: 150ms">
      <span class="eyebrow"
        ><span class="marker" aria-hidden="true"></span>{
          type === "blog" ? "Article" : "Project"
        }</span
      >
      <h2
        class="mt-3 text-3xl font-bold transition-transform duration-700 ease-out-expo lg:text-4xl lg:group-hover:translate-x-2"
      >
        {title}
      </h2>
      <Pills items={stack} class="mt-4" aria-label="Tech stack" />
      <p class="mt-6 leading-relaxed">{excerpt}</p>
      <span
        class="link-underline mt-8 inline-flex items-center gap-2 text-sm font-medium group-hover:after:origin-left group-hover:after:scale-x-100"
      >
        {type === "blog" ? "Read article" : "View project"}
        <span class="arrow" aria-hidden="true">&rarr;</span>
      </span>
    </div>
  </a>
</article>
