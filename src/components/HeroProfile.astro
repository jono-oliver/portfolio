---
import { sanityClient } from "sanity:client";
import { getProfile } from "../sanity/useSanityHelper";
import { Image } from "astro:assets";
import portrait from "../assets/portfolio-image.jpg";
import SkillsGrid from "./SkillsGrid.astro";
import SkillsMarquee from "./SkillsMarquee.astro";
import FoldedPaper from "./FoldedPaper.astro";
import { getHighlights, splitBio } from "../data/profile";

const profile = await getProfile();
const { name, bio, contactEmail, skills, resume, jobRole } = profile;
const cv = await sanityClient.getDocument(resume.asset._ref);

// First word on line one, the rest indented on line two
const [firstName, ...rest] = name.trim().split(/\s+/);
const lastName = rest.join(" ");

const highlights = getHighlights(profile);
const { lead: bioLead, rest: bioRest } = splitBio(bio);
---

<div class="relative isolate overflow-hidden">
<FoldedPaper />

<section data-xray="HeroProfile"
  class="container flex min-h-[calc(100svh-4rem)] flex-col justify-between gap-12 pb-10 pt-10 lg:min-h-[calc(100svh-5rem)] lg:pt-16"
>
  <div
    class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-b border-line pb-4"
    data-reveal="up"
  >
    <span class="eyebrow"
      ><span class="marker" aria-hidden="true"></span>Introduction</span
    >
  </div>

  <div class="grid gap-12 lg:grid-cols-12 lg:items-center lg:gap-8">
    <div class="flex flex-col lg:col-span-7">
      <h1
        class="text-[clamp(3rem,13vw,4.5rem)] font-bold uppercase leading-[0.92] tracking-[-0.03em] sm:text-[clamp(3rem,8vw,7rem)]"
        aria-label={name}
      >
        <span data-reveal="mask" aria-hidden="true"
          ><span>{firstName}</span></span
        >
        {
          lastName && (
            <span
              data-reveal="mask"
              aria-hidden="true"
              style="--reveal-delay: 120ms"
            >
              <span
                class="after:text-accent-text after:content-['.']"
                set:text={lastName}
              />
            </span>
          )
        }
      </h1>

      <p
        class="mt-6 font-heading text-2xl font-medium tracking-tight sm:text-3xl lg:mt-8 lg:text-4xl"
      >
        <span data-reveal="mask" style="--reveal-delay: 240ms">
          <span>{jobRole}</span>
        </span>
      </p>

      <ul
        class="mt-3 flex flex-nowrap items-center gap-x-2.5 whitespace-nowrap text-[clamp(11px,3.4vw,14px)] text-muted sm:flex-wrap sm:gap-x-4 sm:gap-y-1 sm:text-base lg:mt-4 lg:text-lg"
        aria-label="Focus areas"
      >
        {
          highlights.map((point, i) => (
            <li
              class="inline-flex items-center gap-2.5 sm:gap-4"
              data-reveal="up"
              style={`--reveal-delay: ${320 + i * 90}ms`}
            >
              {i > 0 && (
                <span
                  class="block h-1.5 w-1.5 shrink-0 bg-accent-text"
                  aria-hidden="true"
                />
              )}
              <span class="sm:hidden">{point.short}</span>
              <span class="hidden sm:inline">{point.full}</span>
            </li>
          ))
        }
      </ul>

      <div
        class="mt-10 max-w-xl lg:mt-12"
        data-reveal="up"
        style="--reveal-delay: 420ms"
      >
        <p class="text-lg font-medium leading-snug lg:text-xl">{bioLead}</p>
        {
          bioRest && (
            <p class="mt-3 text-base leading-relaxed text-muted lg:text-lg">
              {bioRest}
            </p>
          )
        }
      </div>

      <div
        class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4 lg:mt-12"
        data-reveal="up"
        style="--reveal-delay: 480ms"
      >
        <a
          href={`${cv.url}?dl`}
          class="group inline-flex items-center gap-3 rounded-full bg-ink px-8 py-4 text-base font-medium text-paper transition-colors duration-300 hover:bg-accent hover:text-white"
        >
          Download CV <span class="arrow" aria-hidden="true">&darr;</span>
        </a>
        <a
          href={`mailto:${contactEmail}`}
          class="link-underline group inline-flex items-center gap-2 text-base font-medium"
        >
          Get in touch <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>

    <!-- The wrapper reveals too, so the accent frame fades in with the photo
         rather than showing on its own. Below lg the portrait stacks under
         the CTAs (480ms), so it waits for them; side by side on desktop it
         can come in early. The photo's clip reveal inherits this delay. -->
    <div
      class="relative mr-3 w-full max-w-md justify-self-center [--reveal-delay:600ms] lg:col-span-5 lg:mr-3 lg:justify-self-end lg:[--reveal-delay:200ms]"
      data-reveal="up"
    >
      <div
        class="absolute inset-0 translate-x-3 translate-y-3 border border-accent"
        aria-hidden="true"
      >
      </div>
      <div class="relative overflow-hidden" data-reveal="image">
        <!-- Hardcoded portrait (src/assets/portfolio-image.jpg), optimised by Astro.
             The landscape photo is cropped into a 4:5 frame, so it's drawn
             ~1.67x wider than the frame: `sizes` accounts for that. -->
        <Image
          src={portrait}
          alt={`Portrait of ${name}`}
          widths={[600, 800, 1200, 1600]}
          sizes="(min-width: 1024px) 47rem, 167vw"
          loading="eager"
          class="aspect-[4/5] w-full object-cover"
        />
        <!-- Dark mode: a slate colour blend tints the black-and-white photo
             to match the palette -->
        <div
          class="pointer-events-none absolute inset-0 hidden bg-slate-700 mix-blend-color dark:block"
          aria-hidden="true"
        >
        </div>
      </div>
    </div>
  </div>

  <div class="flex flex-col gap-4 lg:gap-5">
    <SkillsMarquee
      items={skills}
      data-reveal="up"
      style="--reveal-delay: 300ms"
    />
    <SkillsGrid items={skills} delay={400} />
  </div>
</section>
</div>
