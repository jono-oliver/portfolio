---
import { sanityClient } from "sanity:client";
import { getProfile } from "../sanity/useSanityHelper";
import SanityImage from "../components/SanityImage.astro";
import Pills from "./Pills.astro";

const profile = await getProfile();
const { name, bio, contactEmail, skills, resume, profilePicture, jobRole } =
  profile;
const cv = await sanityClient.getDocument(resume.asset._ref);

// First word on line one, the rest indented on line two
const [firstName, ...rest] = name.trim().split(/\s+/);
const lastName = rest.join(" ");
---

<section
  class="container flex min-h-[calc(100svh-4rem)] flex-col justify-between gap-12 pb-10 pt-10 lg:min-h-[calc(100svh-5rem)] lg:pt-16"
>
  <div
    class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-b border-line pb-4"
    data-reveal="up"
  >
    <span class="eyebrow"
      ><span class="marker" aria-hidden="true"></span>Introduction</span
    >
  </div>

  <div>
    <h1 class="text-display font-bold uppercase" aria-label={name}>
      <span data-reveal="mask" aria-hidden="true"><span>{firstName}</span></span
      >
      {
        lastName && (
          <span
            data-reveal="mask"
            aria-hidden="true"
            style="--reveal-delay: 120ms"
            class="lg:pl-[12vw]"
          >
            <span
              class="after:text-accent-text after:content-['.']"
              set:text={lastName}
            />
          </span>
        )
      }
    </h1>

    <p
      class="mt-6 font-heading text-2xl font-medium tracking-tight sm:text-3xl lg:mt-8 lg:pl-[12vw] lg:text-4xl xl:text-5xl"
    >
      <span data-reveal="mask" style="--reveal-delay: 240ms">
        <span>
          <span
            class="mr-4 inline-block h-px w-10 bg-accent-text align-middle lg:mr-6 lg:w-16"
            aria-hidden="true"></span>
          {jobRole}
        </span>
      </span>
    </p>
  </div>

  <div class="grid gap-10 lg:grid-cols-12 lg:items-end lg:gap-8">
    <div class="relative mr-3 max-w-md lg:col-span-4 lg:mr-0">
      <div
        class="absolute inset-0 translate-x-3 translate-y-3 border border-accent"
        aria-hidden="true"
      >
      </div>
      <div
        class="relative overflow-hidden"
        data-reveal="image"
        style="--reveal-delay: 200ms"
      >
        <SanityImage
          classes="aspect-[4/5] w-full object-cover"
          node={profilePicture}
          width="800"
        />
      </div>
    </div>

    <div class="flex flex-col gap-8 lg:col-span-7 lg:col-start-6">
      <p
        class="max-w-xl text-lg leading-relaxed lg:text-xl"
        data-reveal="up"
        style="--reveal-delay: 250ms"
      >
        {bio}
      </p>

      <Pills
        items={skills}
        hoverable
        data-reveal="up"
        style="--reveal-delay: 320ms"
        aria-label="Skills"
      />

      <div
        class="flex flex-wrap items-center gap-x-8 gap-y-4"
        data-reveal="up"
        style="--reveal-delay: 380ms"
      >
        <a
          href={`${cv.url}?dl`}
          class="group inline-flex items-center gap-3 rounded-full bg-ink px-7 py-3.5 text-sm font-medium text-paper transition-colors duration-300 hover:bg-accent hover:text-white"
        >
          Download CV <span class="arrow" aria-hidden="true">&darr;</span>
        </a>
        <a
          href={`mailto:${contactEmail}`}
          class="link-underline group inline-flex items-center gap-2 text-sm font-medium"
        >
          Get in touch <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </div>

  <a
    href="#work"
    class="eyebrow group hidden items-center gap-3 self-start transition-colors hover:text-ink lg:inline-flex"
  >
    <span class="relative block h-8 w-px overflow-hidden bg-line">
      <span class="scroll-line absolute inset-x-0 top-0 h-1/2 bg-ink"></span>
    </span>
    Scroll
  </a>
</section>

<style>
  .scroll-line {
    animation: scroll-line 2.4s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }

  @keyframes scroll-line {
    from {
      transform: translateY(-100%);
    }
    to {
      transform: translateY(200%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-line {
      animation: none;
    }
  }
</style>
