---
// "Recruiter view": the whole site condensed into one scannable screen.
// Opened by any [data-summary-open] button (see Navbar) or by visiting a URL
// ending in #at-a-glance, which makes it easy to share. All content comes
// from Sanity (profile + portfolio projects).
import {
  getProfile,
  getProjects,
  getResumeUrl,
} from "../sanity/useSanityHelper";
import {
  AVAILABILITY,
  SOCIAL,
  getHighlights,
  skillNames,
  splitBio,
} from "../data/profile";

const profile = await getProfile();
const projects = await getProjects();
const { name, bio, contactEmail, jobRole } = profile;
const skills = skillNames(profile);
const cvUrl = await getResumeUrl(profile);

const highlights = getHighlights(profile);
const { lead } = splitBio(bio);
const coreSkills = skills.slice(0, 12);
const selected = projects.slice(0, 3);
---

<dialog
  id="at-a-glance"
  data-summary
  aria-labelledby="summary-title"
  class="summary m-0 h-full max-h-none w-full max-w-none bg-paper p-0 text-ink backdrop:bg-ink/40 backdrop:backdrop-blur-sm sm:m-auto sm:h-fit sm:max-h-[calc(100svh-3rem)] sm:w-[calc(100%-3rem)] sm:max-w-5xl sm:border sm:border-line"
>
  <div class="flex h-full max-h-[inherit] flex-col overflow-y-auto sm:h-auto">
    <div
      class="sticky top-0 z-10 flex items-center justify-between gap-4 border-b border-line bg-paper px-5 py-4 sm:px-8"
    >
      <span class="eyebrow">
        <span class="marker" aria-hidden="true"></span>Recruiter view
      </span>
      <button
        type="button"
        data-summary-close
        class="grid h-9 w-9 place-items-center rounded-full border border-line transition-colors duration-300 hover:border-ink"
        aria-label="Close recruiter view"
      >
        <svg class="h-3.5 w-3.5" viewBox="0 0 14 14" aria-hidden="true">
          <path
            d="M1 1l12 12M13 1L1 13"
            stroke="currentColor"
            stroke-width="1.5"
            fill="none"></path>
        </svg>
      </button>
    </div>

    <div
      class="grid gap-10 px-5 py-8 sm:px-8 sm:py-10 lg:grid-cols-12 lg:gap-12"
    >
      <!-- Who -->
      <div class="flex flex-col gap-6 lg:col-span-5">
        <div>
          {
            AVAILABILITY && (
              <p class="mb-4 inline-flex items-center gap-2 text-sm text-muted">
                <span class="relative flex h-2 w-2" aria-hidden="true">
                  <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-500 opacity-60 motion-reduce:animate-none" />
                  <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500" />
                </span>
                {AVAILABILITY}
              </p>
            )
          }
          <h2
            id="summary-title"
            class="text-4xl font-bold uppercase leading-[0.95] tracking-[-0.03em] sm:text-5xl"
          >
            <span class="after:text-accent-text after:content-['.']"
              >{name}</span
            >
          </h2>
          <p class="mt-3 font-heading text-xl font-medium tracking-tight">
            {jobRole}
          </p>
        </div>

        {lead && <p class="leading-relaxed text-muted">{lead}</p>}

        <ul class="flex flex-col gap-2" aria-label="Focus areas">
          {
            highlights.map((h) => (
              <li class="flex items-center gap-3 text-sm">
                <span class="marker" aria-hidden="true" />
                {h.full}
              </li>
            ))
          }
        </ul>

        <div class="mt-auto flex flex-wrap items-center gap-3 pt-2">
          {
            cvUrl && (
              <a
                href={`${cvUrl}?dl`}
                class="inline-flex items-center gap-2 rounded-full bg-ink px-5 py-2.5 text-sm font-medium text-paper transition-colors duration-300 hover:bg-accent hover:text-white"
              >
                Download CV <span aria-hidden="true">&darr;</span>
              </a>
            )
          }
          <a
            href={`mailto:${contactEmail}`}
            class="inline-flex items-center gap-2 rounded-full border border-line px-5 py-2.5 text-sm font-medium transition-colors duration-300 hover:border-ink"
          >
            Email me <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
        <div class="flex gap-5 text-sm text-muted">
          <a
            href={SOCIAL.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="link-underline hover:text-ink">LinkedIn</a
          >
          <a
            href={SOCIAL.github}
            target="_blank"
            rel="noopener noreferrer"
            class="link-underline hover:text-ink">GitHub</a
          >
        </div>
      </div>

      <!-- What -->
      <div class="flex flex-col gap-10 lg:col-span-7">
        <section aria-labelledby="summary-skills">
          <h3 id="summary-skills" class="eyebrow">Core skills</h3>
          <ul class="mt-4 flex flex-wrap gap-2">
            {
              coreSkills.map((skill: string) => (
                <li class="rounded-full border border-line px-3 py-1.5 text-xs">
                  {skill}
                </li>
              ))
            }
            {
              skills.length > coreSkills.length && (
                <li class="px-1 py-1.5 text-xs text-muted">
                  +{skills.length - coreSkills.length} more
                </li>
              )
            }
          </ul>
        </section>

        <section aria-labelledby="summary-work">
          <h3 id="summary-work" class="eyebrow">Selected work</h3>
          <ul class="mt-2">
            {
              selected.map((project: any) => (
                <li class="border-b border-line last:border-b-0">
                  <a
                    href={`/portfolio/${project.slug.current}`}
                    data-summary-close
                    class="group flex items-start justify-between gap-4 py-4"
                  >
                    <div class="min-w-0">
                      <p class="font-heading text-lg font-bold uppercase leading-tight tracking-tight transition-colors group-hover:text-accent-text">
                        {project.projectTitle}
                      </p>
                      {project.projectExcerpt && (
                        <p class="mt-1 line-clamp-2 text-sm text-muted">
                          {project.projectExcerpt}
                        </p>
                      )}
                      {project.projectTechStack?.length > 0 && (
                        <p class="mt-2 text-xs text-muted">
                          {project.projectTechStack.slice(0, 4).join(" · ")}
                        </p>
                      )}
                    </div>
                    <span
                      class="mt-1 shrink-0 transition-transform duration-500 ease-out-expo group-hover:translate-x-1"
                      aria-hidden="true"
                    >
                      &rarr;
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
          <a
            href="/portfolio"
            data-summary-close
            class="link-underline mt-4 inline-flex items-center gap-2 text-sm font-medium"
          >
            All projects <span aria-hidden="true">&rarr;</span>
          </a>
        </section>
      </div>
    </div>
  </div>
</dialog>

<script>
  const HASH = "#at-a-glance";
  const getDialog = () =>
    document.querySelector<HTMLDialogElement>("dialog[data-summary]");

  const setExpanded = (open: boolean) =>
    document
      .querySelectorAll("[data-summary-open]")
      .forEach((b) => b.setAttribute("aria-expanded", String(open)));

  const open = () => {
    const dialog = getDialog();
    if (!dialog || dialog.open) return;
    dialog.showModal();
    document.documentElement.classList.add("overflow-hidden");
    setExpanded(true);
    if (location.hash !== HASH) history.replaceState(null, "", HASH);
  };

  const close = () => getDialog()?.close();

  // Delegated so it keeps working after view transitions swap the page
  document.addEventListener("click", (e) => {
    const target = e.target as Element;
    if (target.closest("[data-summary-open]")) return open();
    if (target.closest("[data-summary-close]")) return close();
    // Click on the backdrop (outside the panel) closes it
    if (
      target instanceof HTMLDialogElement &&
      target.matches("[data-summary]")
    ) {
      const r = target.getBoundingClientRect();
      const { clientX: x, clientY: y } = e as MouseEvent;
      if (x < r.left || x > r.right || y < r.top || y > r.bottom) close();
    }
  });

  // Runs for Esc, the close button and links alike
  document.addEventListener(
    "close",
    (e) => {
      if (!(e.target as Element).matches?.("dialog[data-summary]")) return;
      document.documentElement.classList.remove("overflow-hidden");
      setExpanded(false);
      if (location.hash === HASH)
        history.replaceState(null, "", location.pathname + location.search);
    },
    true,
  );

  // Shareable link: /#at-a-glance opens straight into the summary
  document.addEventListener("astro:page-load", () => {
    if (location.hash === HASH) open();
  });
  window.addEventListener("hashchange", () => {
    if (location.hash === HASH) open();
  });
</script>

<style>
  .summary[open] {
    animation: summary-in 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .summary[open]::backdrop {
    animation: backdrop-in 0.4s ease-out;
  }

  @keyframes summary-in {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.98);
    }
  }

  @keyframes backdrop-in {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .summary[open],
    .summary[open]::backdrop {
      animation: none;
    }
  }
</style>
