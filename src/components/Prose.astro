---
// Shared typography for portfolio and blog bodies.
// `reveal={false}` drops the scroll reveal, for bodies inside ReadingModes
// (its wrapper reveals both panes; a reveal in a hidden pane would get stuck).
// `compact` trims the top padding so the body sits close to the toggle.
const { reveal = true, compact = false } = Astro.props;
---

<article
  data-xray="Prose"
  class:list={[
    "prose prose-lg mx-auto max-w-measure px-4 dark:prose-invert prose-headings:font-heading prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-ink prose-h2:text-3xl prose-p:leading-relaxed prose-p:text-ink/90 prose-a:text-accent-text prose-a:underline-offset-4 prose-strong:text-ink prose-li:text-ink/90 prose-img:w-full lg:prose-h2:text-4xl",
    compact ? "pb-16 pt-6 lg:pb-24 lg:pt-8" : "py-16 lg:py-24",
  ]}
  data-reveal={reveal ? "up" : undefined}
>
  <slot />
</article>
