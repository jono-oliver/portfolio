---
import HeroProfile from "../components/HeroProfile.astro";
import Layout from "../layouts/Layout.astro";
import FeaturedPortfolio from "../components/FeaturedPortfolio.astro";
import { getProfile } from "../sanity/useSanityHelper";
import { personSchema, websiteSchema } from "../lib/structuredData";
import { OG_IMAGE, SITE_URL } from "../data/site";

const profile = await getProfile();
---

<Layout
  title="Jonathan Oliver | Front End Engineer"
  metaTitle="Home"
  metaDescription="Jonathan Oliver | Front End Engineer"
  metaImage={OG_IMAGE}
  metaUrl={SITE_URL}
  jsonLd={[personSchema(profile), websiteSchema()]}
  alternates={[
    { type: "text/markdown", href: "/index.md" },
    { type: "text/plain", href: "/llms.txt", title: "llms.txt" },
    { type: "application/json", href: "/api/profile.json", title: "Profile" },
  ]}
>
  <HeroProfile />
  <FeaturedPortfolio />
</Layout>
