---
import Layout from "../../layouts/Layout.astro";
import PortableText from "../../components/PortableText.astro";
import DetailHeader from "../../components/DetailHeader.astro";
import NextLink from "../../components/NextLink.astro";
import Prose from "../../components/Prose.astro";
import { absoluteUrl, pageTitle } from "../../data/site";
import { breadcrumbSchema, blogPostingSchema } from "../../lib/structuredData";
import {
  getArticle,
  getArticles,
  urlFor,
  getProfile,
} from "../../sanity/useSanityHelper";

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article, index) => {
    const next = articles[(index + 1) % articles.length];
    return {
      params: { slug: article.slug.current },
      props: {
        next:
          articles.length > 1
            ? { slug: next.slug.current, title: next.articleTitle }
            : null,
      },
    };
  });
}

const { slug } = Astro.params;
const { next } = Astro.props;
const profile = await getProfile();
const article = await getArticle(slug);
const {
  articleTitle,
  articleImage,
  articleExcerpt,
  articleTags,
  articleDescription,
} = article;
const pageUrl = absoluteUrl(`/blog/${slug}/`);
const metaImageUrl = urlFor(articleImage).url();
const jsonLd = [
  blogPostingSchema(article, pageUrl, metaImageUrl),
  breadcrumbSchema([
    { name: "Blog", path: "/blog/" },
    { name: articleTitle, path: `/blog/${slug}/` },
  ]),
];
---

<Layout
  title={pageTitle(profile, "Blog", articleTitle)}
  metaTitle={articleTitle}
  metaDescription={articleExcerpt}
  metaImage={metaImageUrl}
  metaUrl={pageUrl}
  ogType="article"
  jsonLd={jsonLd}
  alternates={[{ type: "text/markdown", href: `/blog/${slug}.md` }]}
>
  <DetailHeader
    title={articleTitle}
    excerpt={articleExcerpt}
    tags={articleTags}
    tagsLabel="Tags"
    image={articleImage}
    backHref="/blog"
    backLabel="All articles"
    transitionName={`blog-${slug}`}
  />

  <Prose>
    <PortableText value={articleDescription} />
  </Prose>

  {
    next && (
      <NextLink
        href={`/blog/${next.slug}`}
        title={next.title}
        label="Next article"
      />
    )
  }
</Layout>
