---
import Layout from "../../layouts/Layout.astro";
import PortableText from "../../components/PortableText.astro";
import DetailHeader from "../../components/DetailHeader.astro";
import NextLink from "../../components/NextLink.astro";
import Prose from "../../components/Prose.astro";
import { getArticle, getArticles, urlFor } from "../../sanity/useSanityHelper";

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article, index) => {
    const next = articles[(index + 1) % articles.length];
    return {
      params: { slug: article.slug.current },
      props: {
        next:
          articles.length > 1
            ? { slug: next.slug.current, title: next.articleTitle }
            : null,
      },
    };
  });
}

const { slug } = Astro.params;
const { next } = Astro.props;
const {
  articleTitle,
  articleImage,
  articleExcerpt,
  articleTags,
  articleDescription,
} = await getArticle(slug);
const metaImageUrl = urlFor(articleImage).url();
---

<Layout
  title=`Jonathan Oliver | Front End Engineer | Portfolio | ${articleTitle}`
  metaTitle={articleTitle}
  metaDescription={articleExcerpt}
  metaImage={metaImageUrl}
  metaUrl=`https://jonooliver.dev/blog/${slug}`
>
  <DetailHeader
    title={articleTitle}
    excerpt={articleExcerpt}
    tags={articleTags}
    tagsLabel="Tags"
    image={articleImage}
    backHref="/blog"
    backLabel="All articles"
    transitionName={`blog-${slug}`}
  />

  <Prose>
    <PortableText value={articleDescription} />
  </Prose>

  {
    next && (
      <NextLink
        href={`/blog/${next.slug}`}
        title={next.title}
        label="Next article"
      />
    )
  }
</Layout>
