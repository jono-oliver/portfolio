---
import type { GetStaticPaths, Page } from "astro";
import Article from "../../components/Article.astro";
import HeadingBlock from "../../components/HeadingBlock.astro";
import Pagination from "../../components/Pagination.astro";
import Layout from "../../layouts/Layout.astro";
import { getArticles } from "../../sanity/useSanityHelper";

export const getStaticPaths = (async ({ paginate }) => {
  const articles = await getArticles();
  return paginate(articles, { pageSize: 6 });
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Page<any> };
const pageSuffix = page.currentPage > 1 ? ` – Page ${page.currentPage}` : "";
---

<Layout
  title={`Jonathan Oliver | Front End Engineer | Portfolio${pageSuffix}`}
  metaTitle={`Blog${pageSuffix}`}
  metaDescription="Learn, Engage, Have some fun!"
  metaImage="https://jonooliver.dev/og-image.jpg"
  metaUrl={`https://jonooliver.dev${page.url.current}`}
>
  <HeadingBlock
    title="Blog"
    subTitle="Learn, Engage, Have some fun!"
    label="Writing"
  />
  <section class="container pb-16 lg:pb-24">
    {
      page.data.map((article, index) => (
        <Article
          key={article._id}
          index={index}
          type="blog"
          slug={article.slug.current}
          title={article.articleTitle}
          excerpt={article.articleExcerpt}
          projectImage={article.articleImage}
          stack={article.articleTags}
        />
      ))
    }
    <Pagination page={page} baseUrl="/blog" />
  </section>
</Layout>
