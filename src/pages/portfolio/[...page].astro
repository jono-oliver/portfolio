---
import type { GetStaticPaths, Page } from "astro";
import ArticleListing from "../../components/ArticleListing.astro";
import Layout from "../../layouts/Layout.astro";
import { breadcrumbSchema } from "../../lib/structuredData";
import { techFilters, type TechFilterOption } from "../../lib/techFilter";
import { OG_IMAGE, absoluteUrl, pageTitle } from "../../data/site";
import { getProjects, getProfile } from "../../sanity/useSanityHelper";

export const getStaticPaths = (async ({ paginate }) => {
  const projects = await getProjects();
  return paginate(projects, {
    pageSize: 6,
    props: { filters: techFilters(projects), total: projects.length },
  });
}) satisfies GetStaticPaths;

const { page, filters, total } = Astro.props as {
  page: Page<any>;
  filters: TechFilterOption[];
  total: number;
};
const crumbs = [{ name: "Work", path: "/portfolio/" }];
if (page.currentPage > 1)
  crumbs.push({ name: `Page ${page.currentPage}`, path: page.url.current });
const profile = await getProfile();
const pageSuffix = page.currentPage > 1 ? ` – Page ${page.currentPage}` : "";
---

<Layout
  title={pageTitle(profile, `Portfolio${pageSuffix}`)}
  metaTitle={`Portfolio${pageSuffix}`}
  metaDescription="A Showcase of Cutting-Edge Projects"
  metaImage={OG_IMAGE}
  metaUrl={absoluteUrl(page.url.current)}
  jsonLd={breadcrumbSchema(crumbs)}
>
  <ArticleListing
    page={page}
    type="portfolio"
    title="Portfolio"
    subTitle="A Showcase of Cutting-Edge Projects"
    label="Recent projects"
    filters={filters}
    total={total}
  />
</Layout>
