---
import Layout from "../../layouts/Layout.astro";
import PortableText from "../../components/PortableText.astro";
import DetailHeader from "../../components/DetailHeader.astro";
import NextLink from "../../components/NextLink.astro";
import Prose from "../../components/Prose.astro";
import { absoluteUrl, pageTitle } from "../../data/site";
import { breadcrumbSchema, projectSchema } from "../../lib/structuredData";
import {
  getProject,
  getProjects,
  urlFor,
  getProfile,
} from "../../sanity/useSanityHelper";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, index) => {
    const next = projects[(index + 1) % projects.length];
    return {
      params: { slug: project.slug.current },
      props: {
        next:
          projects.length > 1
            ? { slug: next.slug.current, title: next.projectTitle }
            : null,
      },
    };
  });
}

const { slug } = Astro.params;
const { next } = Astro.props;
const profile = await getProfile();
const project = await getProject(slug);
const {
  projectTitle,
  projectImage,
  projectExcerpt,
  projectTechStack,
  projectDescription,
} = project;
const pageUrl = absoluteUrl(`/portfolio/${slug}/`);
const metaImageUrl = urlFor(projectImage).url();
const jsonLd = [
  projectSchema(project, pageUrl, metaImageUrl),
  breadcrumbSchema([
    { name: "Work", path: "/portfolio/" },
    { name: projectTitle, path: `/portfolio/${slug}/` },
  ]),
];
---

<Layout
  title={pageTitle(profile, "Portfolio", projectTitle)}
  metaTitle={projectTitle}
  metaDescription={projectExcerpt}
  metaImage={metaImageUrl}
  metaUrl={pageUrl}
  ogType="article"
  jsonLd={jsonLd}
  alternates={[{ type: "text/markdown", href: `/portfolio/${slug}.md` }]}
>
  <DetailHeader
    title={projectTitle}
    excerpt={projectExcerpt}
    tags={projectTechStack}
    tagsLabel="Stack"
    image={projectImage}
    backHref="/portfolio"
    backLabel="All work"
    transitionName={`portfolio-${slug}`}
  />

  <Prose>
    <PortableText value={projectDescription} />
  </Prose>

  {
    next && (
      <NextLink
        href={`/portfolio/${next.slug}`}
        title={next.title}
        label="Next project"
      />
    )
  }
</Layout>
