---
import Layout from "../../layouts/Layout.astro";
import PortableText from "../../components/PortableText.astro";
import DetailHeader from "../../components/DetailHeader.astro";
import NextLink from "../../components/NextLink.astro";
import Prose from "../../components/Prose.astro";
import { getProject, getProjects, urlFor } from "../../sanity/useSanityHelper";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, index) => {
    const next = projects[(index + 1) % projects.length];
    return {
      params: { slug: project.slug.current },
      props: {
        next:
          projects.length > 1
            ? { slug: next.slug.current, title: next.projectTitle }
            : null,
      },
    };
  });
}

const { slug } = Astro.params;
const { next } = Astro.props;
const {
  projectTitle,
  projectImage,
  projectExcerpt,
  projectTechStack,
  projectDescription,
} = await getProject(slug);
const metaImageUrl = urlFor(projectImage).url();
---

<Layout
  title=`Jonathan Oliver | Front End Engineer | Portfolio | ${projectTitle}`
  metaTitle={projectTitle}
  metaDescription={projectExcerpt}
  metaImage={metaImageUrl}
  metaUrl=`https://jonooliver.dev/portfolio/${slug}`
>
  <DetailHeader
    title={projectTitle}
    excerpt={projectExcerpt}
    tags={projectTechStack}
    tagsLabel="Stack"
    image={projectImage}
    backHref="/portfolio"
    backLabel="All work"
    transitionName={`portfolio-${slug}`}
  />

  <Prose>
    <PortableText value={projectDescription} />
  </Prose>

  {
    next && (
      <NextLink
        href={`/portfolio/${next.slug}`}
        title={next.title}
        label="Next project"
      />
    )
  }
</Layout>
